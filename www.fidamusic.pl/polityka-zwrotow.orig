5 8.61616 10.1683 8.82927V13.0439C9.46481 12.8227 8.70938 12.8293 8.0099 13.063C7.31041 13.2966 6.70265 13.7453 6.2734 14.345C5.84415 14.9446 5.61536 15.6646 5.6197 16.402C5.62404 17.1395 5.8613 17.8567 6.29759 18.4512C6.73387 19.0458 7.34688 19.4873 8.04906 19.7127C8.75125 19.9381 9.5067 19.9359 10.2075 19.7063C10.9084 19.4768 11.5188 19.0316 11.9515 18.4345C12.3843 17.8374 12.6173 17.1188 12.6173 16.3813V0H16.7435C16.7406 0.348435 16.7698 0.696395 16.8307 1.03948C16.9741 1.80537 17.2722 2.53396 17.7068 3.18068C18.1415 3.8274 18.7035 4.37867 19.3585 4.80075C20.2903 5.41688 21.3829 5.74528 22.5 5.74505V9.84202Z\&quot;&gt;&lt;/path&gt;\n&lt;/svg&gt;\n&quot;],&quot;icon&quot;:[0,&quot;tiktok&quot;],&quot;link&quot;:[0,&quot;https://www.tiktok.com/@fida_music&quot;]}]]],&quot;mobile&quot;:[0,{&quot;top&quot;:[0,0],&quot;left&quot;:[0,0],&quot;width&quot;:[0,0],&quot;height&quot;:[0,0]}],&quot;desktop&quot;:[0,{&quot;top&quot;:[0,0],&quot;left&quot;:[0,0],&quot;width&quot;:[0,0],&quot;height&quot;:[0,0]}],&quot;settings&quot;:[0,{&quot;styles&quot;:[0,{&quot;align&quot;:[0,&quot;&quot;],&quot;justify&quot;:[0,&quot;center&quot;],&quot;icon-size&quot;:[0,&quot;21px&quot;],&quot;icon-color&quot;:[0,&quot;rgb(255, 255, 255)&quot;],&quot;icon-spacing&quot;:[0,&quot;space-around&quot;],&quot;icon-direction&quot;:[0,&quot;row&quot;],&quot;icon-color-hover&quot;:[0,&quot;rgb(58, 58, 58)&quot;],&quot;m-element-margin&quot;:[0,&quot;0 0 16px 0&quot;],&quot;space-between-icons&quot;:[0,&quot;20px&quot;]}],&quot;useBrandColors&quot;:[0,false]}],&quot;animation&quot;:[0,{&quot;name&quot;:[0,&quot;slide&quot;],&quot;type&quot;:[0,&quot;global&quot;]}]}],&quot;zTAvgL&quot;:[0,{&quot;type&quot;:[0,&quot;GridTextBox&quot;],&quot;mobile&quot;:[0,{&quot;top&quot;:[0,50],&quot;left&quot;:[0,0],&quot;width&quot;:[0,328],&quot;height&quot;:[0,1527]}],&quot;content&quot;:[0,&quot;&lt;h3 dir=\&quot;auto\&quot; style=\&quot;--lineHeightDesktop: 1.3; --fontSizeDesktop: 32px;\&quot;&gt;&lt;strong&gt;Polityka zwrotów i refundacji – &lt;a href=\&quot;http://fidamusic.pl\&quot;&gt;fidamusic.pl&lt;/a&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;strong&gt;1. Zwroty&lt;/strong&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;1. Konsument ma prawo zwrócić zakupiony Produkt w terminie 14 dni od dnia jego otrzymania.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;2. Aby dokonać zwrotu, należy skontaktować się ze Sprzedawcą drogą mailową pod adresem: biuro@zpowazaniem.pl&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;3. Produkt powinien zostać zwrócony w stanie nieużywanym oraz odpowiednio zabezpieczony.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;4. Koszt odesłania Produktu ponosi Klient.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;5. W przypadku nieodebrania przesyłki przez Klienta Sprzedawca może potrącić koszty wysyłki i zwrotu przesyłki.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;strong&gt;2. Refundacje&lt;/strong&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;1. Zwrot środków nastąpi w terminie do 14 dni od dnia otrzymania zwrotu.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;2. Zwrot realizowany jest przy użyciu tej samej metody płatności.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;3. Sprzedawca może wstrzymać się ze zwrotem środków do czasu otrzymania zwracanego Produktu lub dowodu jego nadania.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;strong&gt;3. Produkty wyłączone ze zwrotu&lt;/strong&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;Zwrotowi nie podlegają:&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;- produkty personalizowane,&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;- produkty wykonywane na indywidualne zamówienie,&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;- produkty otwarte ze względów higienicznych, używane lub kiedy w jakikolwiek sposób ich jakość została naruszona.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;strong&gt;4. Reklamacje&lt;/strong&gt;&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;1. Klient ma prawo złożyć reklamację dotyczącą Produktu niezgodnego z umową.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;2. Reklamacje należy zgłaszać drogą mailową wraz z opisem problemu oraz zdjęciami Produktu.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;3. Reklamacje rozpatrywane są w terminie do 14 dni.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;4. W przypadku uznania reklamacji Sprzedawca może wymienić Produkt, naprawić go, obniżyć cenę lub zwrócić środki zgodnie z obowiązującymi przepisami prawa.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body\&quot; style=\&quot;color: rgb(0, 0, 0); letter-spacing: normal; margin-bottom: 0px;\&quot;&gt;&lt;/p&gt;&quot;],&quot;desktop&quot;:[0,{&quot;top&quot;:[0,80],&quot;left&quot;:[0,206],&quot;width&quot;:[0,812],&quot;height&quot;:[0,857]}],&quot;settings&quot;:[0,{&quot;styles&quot;:[0,{&quot;text&quot;:[0,&quot;left&quot;],&quot;align&quot;:[0,&quot;flex-start&quot;],&quot;justify&quot;:[0,&quot;flex-start&quot;],&quot;m-element-margin&quot;:[0,&quot;0 0 16px 0&quot;]}]}],&quot;animation&quot;:[0,{&quot;name&quot;:[0,&quot;slide&quot;],&quot;type&quot;:[0,&quot;global&quot;]}],&quot;initialElementId&quot;:[0,&quot;refund-policy&quot;]}],&quot;zkjqQI&quot;:[0,{&quot;type&quot;:[0,&quot;GridTextBox&quot;],&quot;mobile&quot;:[0,{&quot;top&quot;:[0,163],&quot;left&quot;:[0,0],&quot;width&quot;:[0,328],&quot;height&quot;:[0,12]}],&quot;content&quot;:[0,&qu